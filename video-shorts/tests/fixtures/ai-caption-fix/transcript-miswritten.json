  "segments": [
    {
      "start": 0,
      "end": 4,
      "text": "今日は健康診断の結果についてお話しします"
    },
    {
      "start": 4.5,
      "end": 10.5,
      "text": "血液検査の数値に以上が見つかる方は以外に多いです"
    },
    {
      "start": 11,
      "end": 15,
      "text": "中でも心筋高速は命に関わる病気です"
    },
    {
      "start": 15.5,
      "end": 20,
      "text": "日頃から予防に務めることが大切です"
    },
    {
      "start": 20.5,
      "end": 25.5,
      "text": "気になる方は専門医の受診を進めます"
    },
    {
      "start": 26,
      "end": 31.5,
      "text": "医療費の負担が思いと感じる方もいます"
    },
    {
      "start": 32,
      "end": 37,
      "text": "民間の医療保健に入るという方法もあります"
    },
    {
      "start": 37.5,
      "end": 43,
      "text": "健康に感心のある方はぜひお聞きください"
    },
    {
      "start": 43.5,
      "end": 49,
      "text": "今回の検診の対称は四十歳以上の方です"
    },
    {
      "start": 49.5,
      "end": 53.5,
      "text": "機械があればまた詳しくご説明します"
    }
  ]
