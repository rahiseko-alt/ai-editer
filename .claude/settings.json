{
  "permissions": {
    "deny": [
      "PowerShell(Get-Content *)",
      "Bash(env)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git reset --hard*)",
      "Bash(git branch -D*)",
      "Edit(.env)",
      "Edit(.env.*)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Write(.env)",
      "Write(**/.env)",
      "Edit(.git/**)",
      "Write(.git/**)",
      "Write(**/secrets/**)",
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(npm publish:*)",
      "Bash(npm uninstall:*)",
      "Bash(yarn add:*)",
      "Bash(pip install:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/secrets/**)",
      "Bash(gh auth:*)",
      "Bash(git config user.*)",
      "Bash(git config --global user.*)",
      "Bash(git clean -fd*)",
      "Bash(git stash drop*)",
      "Bash(git stash clear*)",
      "Bash(git restore .)",
      "Bash(git checkout -- .)",
      "Bash(git remote set-url*)",
      "Bash(git commit --amend*)",
      "Bash(gh repo fork*)",
      "Edit(**/secrets/**)"
    ],
    "ask": [
      "Bash(node -e *)",
      "Bash(node --eval*)",
      "Bash(node -p *)",
      "Bash(node --input-type=*)",
      "Bash(npm install *)",
      "Bash(npx --yes*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(terraform:*)",
      "Bash(aws:*)",
      "Bash(gcloud:*)",
      "Bash(vercel --prod*)",
      "Bash(npx vercel --prod*)",
      "Bash(vercel deploy --prod*)",
      "Bash(npm publish:*)",
      "Bash(cmd:*)",
      "Bash(cmd.exe *)",
      "Bash(powershell:*)",
      "Bash(powershell.exe *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Stop-Process *)",
      "Bash(find:*)",
      "Bash(bash -c:*)",
      "Bash(bash:*)"
    ],
    "allow": [
      "Bash(sleep:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(test:*)",
      "Bash(date)",
      "Bash(date:*)",
      "Bash(pwd)",
      "Bash(pwd:*)",
      "Bash(printf:*)",
      "Bash(which:*)",
      "Bash(notepad:*)",
      "Bash(notepad.exe:*)",
      "WebFetch(domain:kouheikosehira.com)",
      "WebFetch(domain:*.kouheikosehira.com)",
      "WebFetch(domain:hnrss.org)",
      "WebFetch(domain:openai.com)",
      "WebFetch(domain:zenn.dev)",
      "WebFetch(domain:rss.itmedia.co.jp)",
      "WebFetch(domain:goworkship.com)",
      "WebFetch(domain:www.nippon.com)",
      "WebFetch(domain:www.technologyreview.jp)",
      "WebFetch(domain:gsap.com)",
      "WebFetch(domain:prtimes.jp)",
      "WebFetch(domain:note.com)",
      "WebFetch(domain:www.anthropic.com)",
      "Bash(export PATH=$PATH:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=post-bash -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-bash.js"
          }
        ]
      },
      {
        "matcher": "Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=post-write -- bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-write.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=rules-coverage-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rules-coverage-gate.mjs",
            "statusMessage": "ルールカバレッジ検証中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=ac-keyword-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/ac-keyword-gate.mjs",
            "statusMessage": "受入条件 keyword 検証中 (Stage 2)..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=line-count-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/line-count-gate.mjs",
            "statusMessage": "500行規律検証中..."
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=pre-edit -- bash \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-edit.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=area-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/area-gate.mjs",
            "statusMessage": "運用エリアゲート検証中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=pre-bash-destructive -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-bash-destructive.mjs"
          }
        ]
      },
      {
        "matcher": "Bash|Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=allow-marker-guard -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/allow-marker-guard.mjs",
            "statusMessage": ".allow-* バイパスマーカーの自己発行チェック中..."
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=pre-git-staging-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/pre-git-staging-gate.mjs",
            "statusMessage": "git 無差別 stage（index sweep）防止チェック中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=secret-write-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/secret-write-gate.mjs",
            "statusMessage": "settings.local.json シークレット混入チェック中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=outside-vibe-base-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/outside-vibe-base-gate.mjs",
            "statusMessage": "vibe-base 外フォルダ編集チェック中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=memory-observation-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-observation-gate.mjs",
            "statusMessage": "memory.md 継続観察パターン検証中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=memory-size-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/memory-size-gate.mjs",
            "statusMessage": "memory 系ファイル byte 上限チェック中..."
          }
        ]
      },
      {
        "matcher": "Read|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=serena-suggest-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/serena-suggest-gate.mjs",
            "statusMessage": "Serena 適用機会チェック中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=job-application-write-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/job-application-write-gate.mjs",
            "statusMessage": "応募文の書き込み経路チェック中..."
          }
        ]
      },
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=plan-daigi-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/plan-daigi-gate.mjs",
            "statusMessage": "plan の大義照合中..."
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=roadmap-state-write-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/roadmap-state-write-gate.mjs",
            "statusMessage": "現在地(roadmap-state.json)の書込検査中..."
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/post-tool-use-failure-triage.mjs",
            "statusMessage": "微細エラー判定支援中（要検証・claude --debugで発火確認前）..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=session-start-handover-inject -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start-handover-inject.mjs",
            "statusMessage": "前回引継ぎレポート強制注入中..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/hook-runner.mjs --hook=job-application-agent-gate -- node \"$CLAUDE_PROJECT_DIR\"/.claude/hooks/job-application-agent-gate.mjs",
            "statusMessage": "応募文サブへの委譲チェック中..."
          }
        ]
      }
    ]
  }
}
